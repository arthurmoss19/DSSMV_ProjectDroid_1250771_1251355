<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent" android:layout_height="match_parent"
              android:background="@color/tt_background" android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            android:background="@color/tt_primary"
            app:navigationIcon="@drawable/icon_back" app:title="@string/place_form_title_new"
            app:titleTextColor="@android:color/white" />

    <ScrollView
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/margin">

            <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/place_form_section_place"
                    android:textColor="@color/tt_primary" android:textSize="16sp" android:textStyle="bold" />

            <EditText
                    android:id="@+id/editPlaceName"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="@string/place_form_name"
                    android:inputType="textCapSentences" android:maxLines="2" />

            <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/place_form_category"
                    android:textColor="@color/tt_text_light" android:textSize="14sp" />

            <Spinner
                    android:id="@+id/spinnerPlaceCategory"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:spinnerMode="dropdown" />

            <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/place_form_rating"
                    android:textColor="@color/tt_text_light" android:textSize="14sp" />

            <RatingBar
                    android:id="@+id/ratingPlace"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:numStars="5" android:rating="3" android:stepSize="1"
                    android:progressTint="@color/tt_accent" android:progressBackgroundTint="@color/tt_outline" />

            <View
                    android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin" android:layout_marginBottom="@dimen/margin"
                    android:background="@color/tt_outline" />

            <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/place_form_section_location"
                    android:textColor="@color/tt_primary" android:textSize="16sp" android:textStyle="bold" />

            <TextView
                    android:id="@+id/textPlaceCoordinates"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/place_form_coordinates_empty"
                    android:textColor="@color/tt_text" android:textSize="16sp" />

            <Button
                    android:id="@+id/buttonGetLocation"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/place_form_get_location" />

            <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:baselineAligned="false" android:orientation="horizontal">

                <EditText
                        android:id="@+id/editLatitude"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/margin_small" android:layout_weight="1"
                        android:hint="@string/place_form_latitude"
                        android:inputType="numberDecimal|numberSigned" />

                <EditText
                        android:id="@+id/editLongitude"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:hint="@string/place_form_longitude"
                        android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <TextView
                    android:id="@+id/textPlaceAddress"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/place_form_address_empty"
                    android:textColor="@color/tt_text" android:textSize="14sp" />

            <View
                    android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin" android:layout_marginBottom="@dimen/margin"
                    android:background="@color/tt_outline" />

            <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/place_form_section_photos"
                    android:textColor="@color/tt_primary" android:textSize="16sp" android:textStyle="bold" />

            <Button
                    android:id="@+id/buttonTakePhoto"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/place_form_take_photo" />

            <TextView
                    android:id="@+id/textPhotoCount"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/place_form_photos_none"
                    android:textColor="@color/tt_text_light" android:textSize="12sp" />

            <ProgressBar
                    android:id="@+id/progressPlaceForm"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <Button
            android:id="@+id/buttonSavePlace"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin" android:text="@string/action_save" />
</LinearLayout>
