<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent" android:layout_height="match_parent"
              android:background="@color/tt_background" android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            android:background="@color/tt_primary"
            app:navigationIcon="@drawable/icon_back" app:title="@string/place_detail_title"
            app:titleTextColor="@android:color/white" />

    <ScrollView
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/margin">

            <ImageView
                    android:id="@+id/imagePlacePhoto"
                    android:layout_width="match_parent" android:layout_height="180dp"
                    android:contentDescription="@string/cd_photo" android:scaleType="centerCrop"
                    android:src="@drawable/icon_empty" />

            <TextView
                    android:id="@+id/textPlaceName"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin"
                    android:textColor="@color/tt_text" android:textSize="22sp" android:textStyle="bold" />

            <TextView
                    android:id="@+id/textPlaceCategory"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/tt_primary" android:textSize="14sp" />

            <RatingBar
                    android:id="@+id/ratingPlace"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:numStars="5" android:rating="0" android:stepSize="1"
                    android:progressTint="@color/tt_accent" android:progressBackgroundTint="@color/tt_outline" />

            <TextView
                    android:id="@+id/textPlaceAddress"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/place_no_address"
                    android:textColor="@color/tt_text" android:textSize="16sp" />

            <TextView
                    android:id="@+id/textPlaceCountry"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/tt_text_light" android:textSize="14sp" />

            <TextView
                    android:id="@+id/textPlaceCoordinates"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/tt_text_light" android:textSize="12sp" />

            <View
                    android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin" android:layout_marginBottom="@dimen/margin"
                    android:background="@color/tt_outline" />

            <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/place_detail_photos_title"
                    android:textColor="@color/tt_primary" android:textSize="16sp" android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPhotos"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            <TextView
                    android:id="@+id/textPhotosEmpty"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/place_detail_photos_empty"
                    android:textColor="@color/tt_text_light" android:textSize="12sp" />

            <Button
                    android:id="@+id/buttonTakePhoto"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin" android:text="@string/place_detail_photos_add" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
