# TripTrail / DSSMV - keep the API keys out of the repository.
# Copy this file to "local.properties" and fill in your own keys.
# "local.properties" is listed in .gitignore, so it never reaches GitHub.
#
# The app also runs with the values below (keys left as "X"): it then uses an
# in-memory mock backend so that the application still executes for the
# checkpoint and for the demo preparation.

# ---------------------------------------------------------------------------
# Android SDK (added automatically by Android Studio)
# ---------------------------------------------------------------------------
# sdk.dir=C\:\\Users\\<user>\\AppData\\Local\\Android\\Sdk

# ---------------------------------------------------------------------------
# RestDB - cloud database with a REST API (https://restdb.io)
# Dashboard -> your database -> Settings -> API keys
# ---------------------------------------------------------------------------
RESTDB_URL=https://triptrail-xxxxxx.restdb.io/
RESTDB_KEY=X

# ---------------------------------------------------------------------------
# APILayer / positionstack - reverse geocoding: GPS -> address
# ---------------------------------------------------------------------------
POSITIONSTACK_URL=http://api.positionstack.com/
POSITIONSTACK_KEY=X

# ---------------------------------------------------------------------------
# APILayer / Fixer - currency exchange rates (free plan is HTTP only)
# https://fixer.io -> dashboard -> API Access Key
# ---------------------------------------------------------------------------
CURRENCY_URL=http://data.fixer.io/api/
CURRENCY_KEY=X

# ---------------------------------------------------------------------------
# APILayer / Countrylayer - country data: currency, language, timezone
# https://countrylayer.com -> dashboard -> API Access Key
# ---------------------------------------------------------------------------
COUNTRYLAYER_URL=http://api.countrylayer.com/v2/
COUNTRYLAYER_KEY=X

# ---------------------------------------------------------------------------
# Development switches
# ---------------------------------------------------------------------------
# true  -> the app reads/writes an in-memory mock backend (works without keys)
# false -> the app talks to the real RestDB database
USE_MOCK_DATA=true

# true  -> address, country and exchange rate come from a fixed mock (saves the 100 requests/month)
# false -> real positionstack / fixer / countrylayer calls
USE_MOCK_ENRICHMENT=true
